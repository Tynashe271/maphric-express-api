# Copy this file to .env and replace every placeholder before running Django.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon: Dashboard → Connect → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT/NEON_DATABASE?sslmode=require

REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Gmail (use a Google App Password, never your normal Gmail password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Twilio SMS (Console -> Account Info and Phone Numbers)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment provider credentials supplied by EcoCash / InnBucks
ECOCASH_API_URL=
ECOCASH_API_KEY=
INNBUCKS_API_URL=
INNBUCKS_API_KEY=
